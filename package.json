{
  "name": "mySlides",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@trpc/server": "^11.5.0",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "wrangler": "^4.40.3",
      "@types/node": "^22.13.11",
      "@trpc/client": "^11.5.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
      "vite-plus": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "check": "vp lint && vp fmt --write",
    "prepare": "vp config",
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r --cache build",
    "check-types": "vp run -r --cache check-types",
    "dev:native": "vp run -F native dev",
    "dev:web": "vp run -F web dev",
    "dev:server": "vp run -F server dev",
    "db:push": "vp run -F @mySlides/db db:push",
    "db:studio": "vp run -F @mySlides/db db:studio",
    "db:generate": "vp run -F @mySlides/db db:generate",
    "db:migrate": "vp run -F @mySlides/db db:migrate"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.13.11",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.2.23"
}
